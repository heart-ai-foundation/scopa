{
  "schema": "scopa.slice-definition.v1",
  "sliceId": "S10-known-failing-consumer",
  "allowedPaths": [
    "workspace/**"
  ],
  "amendmentPath": ".scopa/amendment.json",
  "gates": [
    {
      "id": "known-exit-7",
      "command": [
        "node",
        "-e",
        "process.exit(7)"
      ],
      "cwd": ".",
      "timeoutMs": 5000
    }
  ],
  "nonGoals": [
    "No asserted completion over an exit-7 gate"
  ],
  "stopCondition": {
    "kind": "all-gates-pass"
  }
}
