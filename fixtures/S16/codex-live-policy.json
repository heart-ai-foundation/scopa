  "stopConditions": [
    "account-boundary-drift",
    "capture-limit",
    "cleanup-failure",
    "client-version-drift",
    "evidence-collision",
    "mcp-inventory-drift",
    "model-drift",
    "native-surface-drift",
    "privacy-event",
    "provider-rate-pressure",
    "provider-refusal",
    "schema-drift",
    "timeout",
    "usage-limit"
