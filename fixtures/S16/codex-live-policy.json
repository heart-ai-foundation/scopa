  "cleanup": {
    "processGroupRequired": true,
    "noSurvivorRequired": true,
    "controlRootDeletionRequired": true,
    "disposableRepositoryDeletionRequired": true,
    "clientStoreAuditRequired": true,
    "providerResidueAuditRequired": true
