    "approvalPolicy": "never",
    "ephemeral": true,
    "ignoreUserConfig": true,
    "ignoreRules": true,
    "webSearch": "disabled",
    "disabledFeatures": [
      "apps",
      "auth_elicitation",
      "browser_use",
      "browser_use_external",
      "browser_use_full_cdp_access",
      "code_mode_host",
      "computer_use",
      "goals",
      "guardian_approval",
      "hooks",
      "image_generation",
      "in_app_browser",
      "memories",
      "multi_agent",
      "multi_agent_v2",
      "network_proxy",
      "personality",
      "plugins",
      "remote_plugin",
      "plugin_sharing",
      "shell_snapshot",
      "shell_tool",
      "skill_mcp_dependency_install",
      "skill_search",
      "tool_call_mcp_elicitation",
      "tool_suggest",
      "unified_exec",
      "workspace_dependencies"
    ]
  },
  "environment": {
    "inheritance": "explicit-allowlist",
    "allowedNames": [
      "HOME",
      "LANG",
      "LC_ALL",
      "PATH",
      "SSL_CERT_DIR",
      "SSL_CERT_FILE",
      "XDG_CACHE_HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_RUNTIME_DIR"
    ]
  },
  "limits": {
    "maxProviderInvocations": 4,
    "maxTurnsPerRun": 1,
    "timeoutMs": 180000,
    "maxCaptureBytes": 20971520,
    "maxInputBytes": 1048576,
    "maxInputTokensPerRun": 120000,
    "maxOutputTokensPerRun": 4000,
    "maxReasoningTokensPerRun": 2000,
    "maxTotalTokensPerRun": 126000,
    "maxCampaignInputTokens": 480000,
    "maxCampaignOutputTokens": 16000,
    "maxCampaignTotalTokens": 504000
