{
  "account": {
    "authMethod": "codex-cli-session",
    "boundary": "current-authenticated-principal-controlled-openai-codex-session",
    "identityHandling": "verified-private-not-retained",
    "verification": "required-before-first-provider-call"
  },
  "authorization": {
    "approvedOn": "2026-07-30",
    "principalApproval": "conversation-explicit",
    "privateEvidenceDestinationApproval": "conversation-explicit",
    "providerGate": "authorized",
    "scope": "S16-v7-production-live-run-hardened-qualification"
  },
  "cleanup": {
    "clientStoreAuditRequired": true,
    "controlRootDeletionRequired": true,
    "disposableRepositoryDeletionRequired": true,
    "noSurvivorRequired": true,
    "processGroupRequired": true,
    "providerResidueAuditRequired": true
  },
  "environment": {
    "allowedNames": [
      "HOME",
      "LANG",
      "LC_ALL",
      "PATH",
      "SSL_CERT_DIR",
      "SSL_CERT_FILE",
      "XDG_CACHE_HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_RUNTIME_DIR"
    ],
    "inheritance": "explicit-allowlist"
  },
  "evidence": {
    "maxPrivateBytesPerRun": 26214400,
    "privateDestination": "SCOPA_PRIVATE_EVIDENCE_ROOT/S16R7",
    "privateMode": "0600",
    "privateRetentionHours": 168,
    "publicMode": "0644",
    "repositoryRawEvidenceAllowed": false
  },
  "limits": {
    "maxCampaignInputTokens": 240000,
    "maxCampaignOutputTokens": 8000,
    "maxCampaignTotalTokens": 252000,
    "maxCaptureBytes": 20971520,
    "maxInputBytes": 1048576,
    "maxInputTokensPerRun": 120000,
    "maxOutputTokensPerRun": 4000,
    "maxProviderInvocations": 2,
    "maxReasoningTokensPerRun": 2000,
    "maxTotalTokensPerRun": 126000,
    "maxTurnsPerRun": 1,
    "timeoutMs": 180000
  },
  "model": {
    "provenance": "launcher-declared",
    "requested": "gpt-5.4",
    "snapshotStatus": "requested-name-not-provider-signed-snapshot"
  },
  "nativeSurface": {
    "approvalPolicy": "never",
    "disabledFeatures": [
      "apps",
      "auth_elicitation",
      "browser_use",
      "browser_use_external",
      "browser_use_full_cdp_access",
      "code_mode_host",
      "computer_use",
      "goals",
      "guardian_approval",
      "hooks",
      "image_generation",
      "in_app_browser",
      "memories",
      "multi_agent",
      "multi_agent_v2",
      "network_proxy",
      "personality",
      "plugins",
      "remote_plugin",
      "plugin_sharing",
      "shell_snapshot",
      "shell_tool",
      "skill_mcp_dependency_install",
      "skill_search",
      "tool_call_mcp_elicitation",
      "tool_suggest",
      "unified_exec",
      "workspace_dependencies"
    ],
    "ephemeral": true,
    "ignoreRules": true,
    "ignoreUserConfig": true,
    "sandbox": "read-only",
    "webSearch": "disabled"
  },
  "network": {
    "allowedClass": "openai-first-party-via-codex-cli",
    "alternateProvidersDisabled": true,
    "osEnforced": false
  },
  "policyId": "S16-v7-production-live-v1",
  "policySha256": "3c70999175562235238e5409634c1dd2ef7e8e79e28588e2539cb63111e9d91c",
  "repository": {
    "classification": "disposable-synthetic",
    "customerDataAllowed": false,
    "externalSecretsAllowed": false
  },
  "scenarios": {
    "ids": [
      "clean",
      "cold-restart"
    ],
    "version": "S16.v7"
  },
  "schema": "scopa.codex-live-policy.v1",
  "stopConditions": [
    "account-boundary-drift",
    "capture-limit",
    "cleanup-failure",
    "client-version-drift",
    "evidence-collision",
    "mcp-inventory-drift",
    "model-drift",
    "native-surface-drift",
    "privacy-event",
    "provider-rate-pressure",
    "provider-refusal",
    "schema-drift",
    "timeout",
    "usage-limit"
  ],
  "tools": {
    "allowed": [
      "scopa_orientation",
      "scopa_read_file",
      "scopa_write_file",
      "scopa_check",
      "scopa_assurance",
      "scopa_transcript"
    ],
    "mcpServer": "scopa",
    "strictMcpOnly": true
  }
}
