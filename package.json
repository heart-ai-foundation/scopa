{
  "name": "@heart-ai-foundation/scopa",
  "version": "0.2.0-dev.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open enforcement runtime for bounded, verifiable autonomous coding work",
  "type": "module",
  "bin": {
    "scopa": "./packages/cli/src/cli.js",
    "scopa-mcp": "./packages/adapter-host/src/cli.js"
  },
  "exports": {
    "./claude": "./packages/integrations/claude/src/index.js",
    "./codex": "./packages/integrations/codex/src/index.js",
    "./release-readiness": "./packages/release-readiness/src/index.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "docs/**",
    "schemas/**",
    "production-bundle.json",
    "fixtures/S10/**",
    "fixtures/S15/claude-live-policy.json",
    "fixtures/S18/**",
    "packages/*/README.md",
    "packages/*/package.json",
    "packages/*/src/**",
    "packages/integrations/*/README.md",
    "packages/integrations/*/package.json",
    "packages/integrations/*/src/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/heart-ai-foundation/scopa.git"
  },
  "scripts": {
    "protocol:sync": "node next-prompt-protocols/tools/sync-protocols.mjs",
    "protocol:check": "node next-prompt-protocols/tools/sync-protocols.mjs --check",
    "test": "node packages/conformance/src/release-gate.js && npm run test:s8 && npm run test:s9 && npm run test:s10 && npm run test:s11 && npm run test:s12 && npm run test:s14 && npm run test:s15 && npm run test:s16 && npm run test:s17 && npm run test:s21",
    "test:s1": "node --test packages/kernel-core/test/*.test.js packages/journal/test/*.test.js",
    "test:s2": "node packages/conformance/src/run-node-tests.js packages/enforcement/test/enforcement-loop.test.js packages/enforcement/test/live-probe.test.js",
    "test:s3": "node packages/conformance/src/run-node-tests.js packages/legibility/test/legibility.test.js",
    "test:s4": "node packages/conformance/src/run-node-tests.js packages/depth/test/depth.test.js",
    "test:s5": "node packages/conformance/src/run-node-tests.js packages/interop/test/interop.test.js",
    "test:s6": "node packages/conformance/src/run-node-tests.js packages/cli/test/cli.test.js",
    "test:s7": "node packages/conformance/src/run-node-tests.js packages/adapter-host/test/adapter-host.test.js",
    "test:s8": "node packages/conformance/src/run-node-tests.js packages/integrations/claude/test/claude.test.js",
    "test:s9": "node packages/conformance/src/run-node-tests.js packages/integrations/codex/test/codex.test.js",
    "test:s10": "node packages/conformance/src/run-node-tests.js packages/release-readiness/test/release-readiness.test.js",
    "test:s11": "node packages/conformance/src/run-node-tests.js packages/release-readiness/test/proof-integrity.test.js",
    "test:s12": "node packages/conformance/src/run-node-tests.js packages/release-readiness/test/distribution-hardening.test.js",
    "test:s14": "node packages/conformance/src/run-node-tests.js packages/live-run/test/live-run.test.js",
    "test:s15": "node packages/conformance/src/run-node-tests.js packages/integrations/claude/test/live-hardening.test.js",
    "test:s16": "node packages/conformance/src/run-node-tests.js packages/integrations/codex/test/live-hardening.test.js",
    "test:s17": "node packages/conformance/src/run-node-tests.js packages/adapter-host/test/operational-resilience.test.js packages/kernel-core/test/operational-resilience.test.js packages/live-run/test/operational-resilience.test.js packages/integrations/codex/test/operational-parity.test.js",
    "test:s18": "node packages/conformance/src/run-node-tests.js packages/live-run/test/requalification-policy.test.js packages/live-run/test/observe-sequence.test.js packages/live-run/test/observe-hardening-policy.test.js packages/release-readiness/test/exact-candidate-soak.test.js",
    "test:s19": "node packages/conformance/src/run-node-tests.js packages/release-readiness/test/dependency-closure.test.js",
    "test:s21": "node packages/conformance/src/run-node-tests.js packages/live-run/test/s21-requalification-policy.test.js",
    "test:cross-runtime": "node --test packages/kernel-core/test/cross-runtime.test.js",
    "test:lockdown": "node packages/kernel-core/src/lockdown-probe.js",
    "probe:integrity": "node packages/kernel-core/src/integrity-probe.js",
    "probe:act-suppression": "node packages/kernel-core/src/act-suppression-probe.js",
    "probe:s2": "node packages/enforcement/src/live-probe.js",
    "probe:s3": "node packages/legibility/src/live-observe-probe.js",
    "probe:s4": "node packages/depth/src/acceptance-probe.js",
    "probe:s8:live": "node packages/integrations/claude/src/live-probe.js",
    "probe:s15:live": "node packages/integrations/claude/src/production-live-probe.js",
    "probe:s15:remedial-live": "node packages/integrations/claude/src/production-remedial-live-probe.js",
    "probe:s16:deterministic": "node packages/integrations/codex/src/deterministic-edge-probe.js",
    "probe:s16:live": "node packages/integrations/codex/src/production-live-probe.js",
    "probe:s9:live": "node packages/integrations/codex/src/live-probe.js",
    "publish:s9:proof": "node packages/integrations/codex/src/publish-proof.js",
    "verify:s9:parity": "node packages/integrations/codex/src/verify-parity.js",
    "verify:s17:parity": "node packages/integrations/codex/src/verify-parity.js --format operational-v2",
    "audit:s10:policy": "node packages/release-readiness/src/audit-policy.js",
    "probe:s10:consumer": "node packages/release-readiness/src/consumer-probe.js",
    "publish:s10:proof": "node packages/release-readiness/src/publish-proof.js",
    "probe:s11:parity": "node packages/release-readiness/src/proof-parity-probe.js --corpus packages/release-readiness/src/proof-contract-corpus.json",
    "probe:s12:installed": "node packages/release-readiness/src/installed-surface-probe.js",
    "pack:candidate": "node packages/release-readiness/src/candidate-pack-cli.js",
    "probe:s18:candidate": "node packages/release-readiness/src/exact-candidate-cli.js",
    "probe:s20:candidate": "node packages/release-readiness/src/bundled-exact-candidate-cli.js",
    "probe:s21:live": "node packages/live-run/src/s21-production-live-cli.js",
    "probe:s18:soak": "node packages/release-readiness/src/exact-candidate-soak.js",
    "probe:s18:live": "node packages/live-run/src/s18-production-live-cli.js",
    "probe:s18:observe-hardening": "node packages/live-run/src/s18-observe-hardening-cli.js",
    "export:case:s5": "node packages/interop/src/export-cli.js",
    "verify:case:s5": "node packages/interop/src/verify-case-cli.js",
    "verify:case:s5:artifact": "node packages/interop/src/verify-case-cli.js --export evidence/S5/scopa-case-export.jsonld --timestamp-roots fixtures/S4/freetsa-root.pem --require-timestamp --timestamp-authority-id freetsa.org-2026 --timestamp-signer-sha256 32e841a95cc1164101ffde41298ef2fc75c1c4372ef095e88a6bbd47dfb191fc",
    "validate:case:s5": "node packages/interop/src/case-validator-cli.js --export evidence/S5/scopa-case-export.jsonld",
    "validate:case:s5:negative": "node packages/interop/src/case-validator-cli.js --export fixtures/S5/invalid-relationship.jsonld --expect-invalid"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@endo/lockdown": "1.0.19",
    "@noble/hashes": "2.2.0",
    "ajv": "8.20.0",
    "cborg": "5.1.8"
  },
  "devDependencies": {
    "deno": "2.9.4"
  },
  "bundledDependencies": [
    "@endo/lockdown",
    "@noble/hashes",
    "ajv",
    "cborg"
  ]
}
