{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heart-ai-foundation.github.io/scopa/schemas/scopa.begin-request.v1.schema.json",
  "title": "SCOPA begin request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sliceId",
    "outcome",
    "allowedPaths",
    "gates",
    "nonGoals",
    "clientProfile"
  ],
  "properties": {
    "schema": {
      "const": "scopa.begin-request.v1"
    },
    "sliceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "cwd", "timeoutMs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          }
        }
      }
    },
    "nonGoals": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "clientProfile": {
      "enum": ["claude-code", "codex", "generic"]
    }
  }
}
