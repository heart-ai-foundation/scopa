{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heart-ai-foundation.github.io/scopa/schemas/scopa.candidate-manifest.v1.schema.json",
  "title": "SCOPA candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "package",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "scopa.candidate-manifest.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "const": false
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "filename",
        "entryCount",
        "packedBytes",
        "unpackedBytes",
        "shasum",
        "integrity",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "@heart-ai-foundation/scopa"
        },
        "version": {
          "const": "0.2.0-dev.1"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "entryCount": {
          "type": "integer",
          "minimum": 1
        },
        "packedBytes": {
          "type": "integer",
          "minimum": 1
        },
        "unpackedBytes": {
          "type": "integer",
          "minimum": 1
        },
        "shasum": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
