{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heart-ai-foundation.github.io/scopa/schemas/scopa.production-bundle.v1.schema.json",
  "title": "SCOPA production bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "packages",
    "files",
    "licenses",
    "closureSha256",
    "bundledPayloadSha256",
    "licenseInventorySha256",
    "manifestSha256"
  ],
  "properties": {
    "schema": { "const": "scopa.production-bundle.v1" },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "bundledDependencies"],
      "properties": {
        "name": { "const": "@heart-ai-foundation/scopa" },
        "version": { "const": "0.2.0" },
        "bundledDependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "name", "version", "resolved", "integrity", "dependencies"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "resolved": { "type": "string", "pattern": "^https://registry\\.npmjs\\.org/" },
          "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path", "specifier"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "path": { "$ref": "#/$defs/path" },
                "specifier": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "mode", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "mode": { "type": "integer", "enum": [420, 493] },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "name", "version", "license", "noticeFiles"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "noticeFiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "sha256": { "$ref": "#/$defs/digest" }
              }
            }
          }
        }
      }
    },
    "closureSha256": { "$ref": "#/$defs/digest" },
    "bundledPayloadSha256": { "$ref": "#/$defs/digest" },
    "licenseInventorySha256": { "$ref": "#/$defs/digest" },
    "manifestSha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\\\]+$"
    }
  }
}
