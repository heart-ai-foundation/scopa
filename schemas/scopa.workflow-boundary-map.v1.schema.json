{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heart-ai-foundation.github.io/scopa/schemas/scopa.workflow-boundary-map.v1.schema.json",
  "title": "SCOPA workflow boundary map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bindings", "subject", "scope", "completion", "surfaces", "summary", "assurance"],
  "properties": {
    "schema": { "const": "scopa.workflow-boundary-map.v1" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceLockSha256", "completionSha256", "capabilityMatrixSha256", "authorityDeclarationsSha256"],
      "properties": {
        "sliceLockSha256": { "$ref": "#/$defs/sha256" },
        "completionSha256": { "$ref": "#/$defs/sha256" },
        "capabilityMatrixSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "authorityDeclarationsSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "client", "transport"],
      "properties": {
        "adapter": { "$ref": "#/$defs/nullableString" },
        "client": { "$ref": "#/$defs/nullableString" },
        "transport": { "$ref": "#/$defs/nullableString" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceId", "allowedPaths", "amendmentPath", "nonGoals"],
      "properties": {
        "sliceId": { "$ref": "#/$defs/nonEmptyString" },
        "allowedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "amendmentPath": { "$ref": "#/$defs/nonEmptyString" },
        "nonGoals": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "status", "canStop", "failedGates", "gates"],
      "properties": {
        "condition": { "const": "all-gates-pass" },
        "status": { "enum": ["blocked", "satisfied"] },
        "canStop": { "type": "boolean" },
        "failedGates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "controlled", "uncontrolled", "unknown", "authorityRequired", "disabled"],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "controlled": { "$ref": "#/$defs/count" },
        "uncontrolled": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" },
        "authorityRequired": { "$ref": "#/$defs/count" },
        "disabled": { "$ref": "#/$defs/count" }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": { "enum": ["full", "partial", "unknown"] },
        "basis": { "enum": ["complete-known-surface", "active-uncontrolled-route", "incomplete-capability-evidence"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "anyOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "count": { "type": "integer", "minimum": 0 },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "exitCode"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["failed", "passed", "timed-out"] },
        "exitCode": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "source", "control", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "enum": ["browser", "completion", "credentials", "deployment", "extension", "external-system", "network", "observe", "process", "provider", "publication", "repository"] },
        "status": { "enum": ["authority-required", "controlled", "disabled", "uncontrolled", "unknown"] },
        "source": { "enum": ["authority-declaration", "capability-matrix", "missing-evidence", "slice-lock", "stop-state"] },
        "control": { "$ref": "#/$defs/nullableString" },
        "evidence": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
